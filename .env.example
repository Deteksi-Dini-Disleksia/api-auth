# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=dyslexia_screening
PGUSER=postgres
PGPASSWORD=password

# JWT Secrets
ACCESS_TOKEN_KEY=your-secret-access-token-key-change-this
REFRESH_TOKEN_KEY=your-secret-refresh-token-key-change-this

# Token Expiration
ACCESS_TOKEN_AGE_MOBILE=1d
ACCESS_TOKEN_AGE_WEB=10m

# Server
PORT=3000

# SMTP Configuration - Using Mailtrap for testing
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Tes Disleksia <your-email@gmail.com>"
APP_URL=domain-api-auth
FRONTEND_URL=domain-web-dashboard

# SMTP Configuration - Using Gmail Client for Production
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=emailkamu@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx    # App Password, bukan password biasa
# SMTP_FROM="Tes Disleksia <emailkamu@gmail.com>"